# ============================================================
#  MasterMonitor – Instance 1
#  Copier ce fichier sur la VM sous le nom : .env.local
#  Adapter les valeurs entre <> avant le déploiement
# ============================================================

# --- Identité de l'instance ---
MM_INSTANCE_ID=instance-1
MM_INSTANCE_NAME=MasterMonitor-1

# --- Active Directory / LDAP ---
# DC1 principal ; DC2 en secours (séparés par virgule si le code le supporte)
LDAP_URL=ldap://192.168.23.145:389
LDAP_BASE_DN=dc=monitor,dc=local
LDAP_BIND_DN=cn=svc-ldap,cn=Users,dc=monitor,dc=local
LDAP_BIND_PASSWORD=Azerty1234@
LDAP_USER_FILTER=(&(objectCategory=person)(objectClass=user))
LDAP_ADMIN_GROUPS=Administrateurs;Administrateurs de l'entreprise;Administrateurs du schéma;Admins du domaine;Propriétaires créateurs de la stratégie de groupe;Utilisateurs du domaine

# --- Compte de service monitoring distant ---
MM_REMOTE_USER=MONITOR\Administrateur
MM_REMOTE_PASS=Azerty1234@

# --- Compte SSH pour les serveurs Linux ---
# Utilisateur SSH sur les serveurs Linux supervisés (ex: 192.168.23.147)
MM_SSH_USER=app1
MM_SSH_PASS=Azerty1234@

# --- PostgreSQL primaire ---
DATABASE_URL=postgresql://mm_app:Azerty1234%40@192.168.23.147:5432/mastermonitor

# --- Pool PostgreSQL (optionnel) ---
PG_POOL_MAX=10
PG_IDLE_TIMEOUT_MS=30000
PG_CONNECT_TIMEOUT_MS=5000

# --- Next.js ---
# URL publique du load balancer Nginx (à compléter quand l'IP Nginx sera connue)
# NEXT_PUBLIC_APP_URL=http://<IP_NGINX>
# Port d'écoute de cette instance (PM2 le passe via PORT)
PORT=3000
NODE_ENV=production
